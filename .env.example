# Credenciales de Huawei Cloud
CLOUD_SDK_AK=tu-access-key
CLOUD_SDK_SK=tu-secret-key

# Region donde estan los backups CBR (origen)
SOURCE_REGION=la-south-2

# Region donde se creara el bucket OBS destino
# Si es distinta a SOURCE_REGION, se activa cross-region copy
TARGET_REGION=la-south-2

# Filtrar por vault (opcional)
VAULT_ID=

# Bucket OBS destino (storage class Standard obligatorio para ExportImage)
OBS_BUCKET_NAME=cbr-backup-images
OBS_BUCKET_PREFIX=backups

# Fast export: true = zvhd2 (rapido, soporta >128GiB)
#              false = usa FILE_FORMAT (qcow2/vhd/zvhd/vmdk)
FAST_EXPORT=true
FILE_FORMAT=qcow2

# Tipo de volumen temporal para restaurar el backup
VOLUME_TYPE=SATA

# OS version para IMS CreateImage (requerido cuando se usa volume_id)
OS_VERSION=CentOS 7.9 64bit

# Prefijo para nombres de imagen
IMAGE_NAME_PREFIX=img-from-backup

# Cross-region: agency IAM y project name destino (requeridos si TARGET_REGION != SOURCE_REGION)
AGENCY_NAME=
TARGET_PROJECT_NAME=

# Limpiar volumenes e imagenes temporales despues del export
CLEANUP=false

# Polling
POLL_INTERVAL=15
POLL_TIMEOUT=3600

# Filtrar backups por nombre (opcional)
BACKUP_NAME_FILTER=

# Solo descubrir backups sin ejecutar
DRY_RUN=false
