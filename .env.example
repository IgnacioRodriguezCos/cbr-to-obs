# =============================================================================
# CBR-to-OBS Migration - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# These variables are set as FunctionGraph environment variables.
# =============================================================================

# --- Huawei Cloud Credentials (AK/SK) ---
# Create at: IAM > Access Keys > Create Access Key
HW_ACCESS_KEY=your-access-key-here
HW_SECRET_KEY=your-secret-key-here

# --- Project IDs (one per region) ---
# Find at: IAM > Projects > Project ID
HW_PROJECT_ID_BUENOSAIRES=your-buenosaires-project-id
HW_PROJECT_ID_SANTIAGO=your-santiago-project-id

# --- CBR Vault IDs (for cross-region replication) ---
# Find at: CBR > Vaults > Vault ID
# Required only if using cross-region migration
HW_VAULT_ID_BUENOSAIRES=your-buenosaires-vault-id
HW_VAULT_ID_SANTIAGO=your-santiago-vault-id

# --- OBS State Bucket ---
# Bucket for storing migration job state (must exist)
OBS_STATE_BUCKET=cbr-migration-state
OBS_STATE_REGION=sa-argentina-1

# --- Temporary Resource Configuration ---
# Volume type for temporary EVS volumes (SATA, SSD, GPSSD)
TEMP_VOLUME_TYPE=SATA

# Availability zones for temporary volumes
TEMP_AZ_BUENOSAIRES=sa-argentina-1a
TEMP_AZ_SANTIAGO=la-south-2a

# --- Cleanup Configuration ---
# Delete temporary volumes and images after export (true/false)
CLEANUP_AFTER_EXPORT=true

# --- Retry Configuration ---
# Maximum retries before marking a job as failed
MAX_RETRIES=5

# --- Raw Export Path (volumes > 1TB, bypasses IMS limit) ---
# Volumes larger than this threshold use dd + obsutil via a temp ECS
# instead of IMS image export (which is limited to ~1TB).
RAW_EXPORT_THRESHOLD_GB=1024

# obsutil download URL (Linux 64-bit)
OBSUTIL_URL=https://obs-utils.obs.cn-north-4.myhuaweicloud.com/obsutil_latest_linux64.tar.gz

# Multipart upload settings (part size in MB, parallel uploads)
# For 5TB: part_mb=600 -> ~9000 parts (OBS max 10000). Flavor needs >=2GB RAM.
TEMP_RAW_PART_MB=600
TEMP_RAW_CONCURRENCY=3

# Temp ECS settings per region (required only for raw export path)
# Find image ID at: IMS > Images (use a small Linux, e.g. Ubuntu 22.04)
# Find flavor at: ECS > Flavors (e.g. s6.large.2mem, >=4GB RAM recommended)
# Find network ID at: VPC > Subnets > Network ID
TEMP_ECS_IMAGE_ID_BA=
TEMP_ECS_FLAVOR_BA=
TEMP_ECS_NETWORK_ID_BA=
TEMP_ECS_IMAGE_ID_CL=
TEMP_ECS_FLAVOR_CL=
TEMP_ECS_NETWORK_ID_CL=
# Optional SSH keypair name (if not set, random password is generated)
TEMP_ECS_KEYPAIR=
